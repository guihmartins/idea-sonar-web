{
  "name": "idea-sonar-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.9.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "npm run contracts:check && npm run typecheck && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "contracts:check": "node scripts/contracts.mjs check",
    "contracts:generate": "node scripts/contracts.mjs generate",
    "contracts:import": "node scripts/contracts.mjs import",
    "dev:fixtures": "VITE_ENABLE_FIXTURES=true vite",
    "test:e2e:fixtures": "playwright test --config playwright.fixtures.config.ts",
    "test:container": "sh scripts/smoke-container.sh",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json *.yml docs README.md .github",
    "format:check": "prettier --check src tests scripts *.ts *.mjs *.json *.yml docs README.md .github",
    "test:mutation": "stryker run",
    "test:mutation:baseline": "vitest run --config vitest.mutation.config.ts"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "2.29.0",
    "@tanstack/react-query": "5.104.5",
    "cytoscape": "3.34.4",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
