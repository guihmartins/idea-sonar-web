# Somente a origem da API (sem /api/v1). HTTP é aceito em dev e em build
# (local/Docker); em produção use a URL https do proxy (ex.: certbot na EC2).
VITE_API_BASE_URL=http://localhost:3000
VITE_AUTH_MODE=none

# Para reativar login: VITE_AUTH_MODE=oidc e configurar abaixo.
# VITE_OIDC_ISSUER=https://identity.example.com/
# VITE_OIDC_CLIENT_ID=public-spa-client-id
# VITE_OIDC_AUDIENCE=https://api.example.com
